{
  "name": "arenagg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@chavea/web",
    "build": "npm run build --workspace=@chavea/web",
    "preview": "npm run preview --workspace=@chavea/web",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed:cards": "node scripts/seed-chavea-cards.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
