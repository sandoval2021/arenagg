generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompetitionType {
  LEAGUE
  KNOCKOUT
  GROUPS_KNOCKOUT
  ENDLESS
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION
  READY
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum LegFormat {
  SINGLE
  HOME_AWAY
}

enum MatchPace {
  QUICK
  SCHEDULED
}

enum TeamSelection {
  FREE
  RANDOM
}

enum ParticipantStatus {
  PENDING
  ACTIVE
  REJECTED
  REMOVED
}

enum StageType {
  LEAGUE
  GROUP
  KNOCKOUT
}

enum StageStatus {
  PENDING
  ACTIVE
  FINISHED
}

enum MatchStatus {
  PENDING
  AWAITING_APPROVAL
  DISPUTED
  FINISHED
  CANCELED
}

enum MatchStatsStatus {
  NONE
  PENDING_APPROVAL
  APPROVED
  DISPUTED
}

enum TeamSource {
  CUSTOM
  GALLERY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  displayName           String?
  avatarUrl             String?
  email                 String?         @unique
  emailVerified         DateTime?
  phone                 String?         @unique
  phoneVerified         DateTime?
  passwordHash          String?
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  profile               UserProfile?
  accounts              AuthAccount[]
  sessions              Session[]
  hostedCompetitions    Competition[]   @relation("CompetitionHost")
  participations        Participation[]
  createdTeams          Team[]          @relation("TeamCreator")
  submittedMatches      Match[]         @relation("MatchSubmittedBy")
  submittedMatchStats   MatchStats[]    @relation("MatchStatsSubmittedBy")
  reviewedMatchStats    MatchStats[]    @relation("MatchStatsReviewedBy")
  defaultShields        DefaultShield[] @relation("DefaultShieldCreator")
  sentFriendships       Friendship[]    @relation("FriendshipRequester")
  receivedFriendships   Friendship[]    @relation("FriendshipAddressee")
}

model UserProfile {
  userId               String   @id @db.Uuid
  totalWins            Int      @default(0)
  totalDraws           Int      @default(0)
  totalLosses          Int      @default(0)
  totalGoalsScored     Int      @default(0)
  totalGoalsConceded   Int      @default(0)
  championshipsWon     Int      @default(0)
  consoles             String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model AuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Competition {
  id                             String            @id @default(uuid()) @db.Uuid
  hostId                         String            @db.Uuid
  name                           String
  slug                           String            @unique
  description                    String?
  logoUrl                        String?
  game                           String?
  platform                       String?
  type                           CompetitionType
  status                         CompetitionStatus @default(DRAFT)
  legFormat                      LegFormat         @default(SINGLE)
  matchPace                      MatchPace         @default(QUICK)
  teamSelection                  TeamSelection     @default(FREE)
  maxParticipants                Int               @default(20)
  firstPrize                     String?
  secondPrize                    String?
  thirdPrize                     String?
  maxTeams                       Int?
  groupCount                     Int?
  qualifiersPerGroup             Int?
  thirdPlaceMatch                Boolean           @default(false)
  requireValidation              Boolean           @default(false)
  pointsWin                      Int               @default(3)
  pointsDraw                     Int               @default(1)
  pointsLoss                     Int               @default(0)
  timezone                       String            @default("America/Sao_Paulo")
  startsAt                       DateTime?
  endsAt                         DateTime?
  championshipProfileAppliedAt   DateTime?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  host                           User               @relation("CompetitionHost", fields: [hostId], references: [id], onDelete: Restrict)
  participations                 Participation[]
  teams                          Team[]
  stages                         Stage[]
  matches                        Match[]
  invites                        CompetitionInvite[]

  @@index([hostId, status])
  @@index([game, platform])
  @@index([championshipProfileAppliedAt])
}

model Participation {
  id            String            @id @default(uuid()) @db.Uuid
  competitionId String            @db.Uuid
  userId        String            @db.Uuid
  status        ParticipantStatus @default(PENDING)
  teamName      String            @default("Meu Time")
  teamLogoUrl   String?
  joinedAt      DateTime          @default(now())
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?

  @@unique([competitionId, userId])
}

model TeamTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  logoUrl  String
  country  String?
  league   String?
  isActive Boolean @default(true)
  teams    Team[]
}

model Team {
  id              String        @id @default(uuid()) @db.Uuid
  competitionId   String        @db.Uuid
  participationId String        @unique @db.Uuid
  createdById     String        @db.Uuid
  templateId      String?       @db.Uuid
  name            String
  shortName       String?
  logoUrl         String?
  source          TeamSource    @default(CUSTOM)
  competition     Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  template        TeamTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  groupEntries    GroupTeam[]
  homeMatches     Match[]       @relation("HomeTeam")
  awayMatches     Match[]       @relation("AwayTeam")
  matchScorers    MatchScorer[]

  @@unique([competitionId, name])
}

model Stage {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  type          StageType
  name          String
  order         Int
  status        StageStatus @default(PENDING)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  groups        Group[]
  rounds        Round[]
  matches       Match[]

  @@unique([competitionId, order])
}

model Group {
  id      String      @id @default(uuid()) @db.Uuid
  stageId String      @db.Uuid
  name    String
  order   Int
  stage   Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  teams   GroupTeam[]
  matches Match[]

  @@unique([stageId, order])
}

model GroupTeam {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  teamId  String @db.Uuid
  seed    Int?
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
}

model Round {
  id          String      @id @default(uuid()) @db.Uuid
  stageId     String      @db.Uuid
  number      Int
  name        String?
  status      StageStatus @default(PENDING)
  scheduledAt DateTime?
  stage       Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches     Match[]

  @@unique([stageId, number])
}

model Match {
  id                   String       @id @default(uuid()) @db.Uuid
  competitionId        String       @db.Uuid
  stageId              String       @db.Uuid
  roundId              String?      @db.Uuid
  groupId              String?      @db.Uuid
  homeTeamId           String?      @db.Uuid
  awayTeamId           String?      @db.Uuid
  homeTeamName         String?
  awayTeamName         String?
  status               MatchStatus  @default(PENDING)
  bracketPosition      Int?
  leg                  Int          @default(1)
  scheduledAt          DateTime?
  homeScore            Int?
  awayScore            Int?
  homePenaltyScore     Int?
  awayPenaltyScore     Int?
  playerAEvidenceUrl   String?
  playerBEvidenceUrl   String?
  submittedById        String?      @db.Uuid
  nextMatchId          String?      @db.Uuid
  nextMatchSlot        String?
  version              Int          @default(1)
  profileAppliedAt     DateTime?
  competition          Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stage                Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  round                Round?       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  group                Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeTeam             Team?        @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam             Team?        @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  submittedBy          User?        @relation("MatchSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  nextMatch            Match?       @relation("BracketProgression", fields: [nextMatchId], references: [id], onDelete: SetNull)
  previousMatches      Match[]      @relation("BracketProgression")
  stats                MatchStats?
  scorers              MatchScorer[]

  @@index([competitionId, status])
  @@index([stageId, roundId])
  @@index([groupId])
  @@index([profileAppliedAt])
}

model MatchScorer {
  id         String   @id @default(uuid()) @db.Uuid
  matchId    String   @db.Uuid
  teamId     String   @db.Uuid
  playerName String
  playerKey  String
  goals      Int
  createdAt  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId, playerKey])
  @@index([matchId, teamId])
  @@index([teamId, playerKey])
}

model MatchStats {
  matchId           String           @id @db.Uuid
  statsStatus       MatchStatsStatus @default(NONE)
  homePossession    Int
  awayPossession    Int
  homeShots         Int
  awayShots         Int
  homeShotsOnGoal   Int
  awayShotsOnGoal   Int
  homePasses        Int
  awayPasses        Int
  homeTackles       Int
  awayTackles       Int
  homeFouls         Int
  awayFouls         Int
  submittedById     String           @db.Uuid
  reviewedById      String?          @db.Uuid
  submittedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  match             Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy       User             @relation("MatchStatsSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy        User?            @relation("MatchStatsReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([statsStatus])
  @@index([submittedById])
}

model DefaultShield {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  url         String
  storagePath String   @unique
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("DefaultShieldCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive, sortOrder])
}

model CompetitionInvite {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  tokenHash     String      @unique
  isActive      Boolean     @default(true)
  expiresAt     DateTime?
  maxUses       Int?
  useCount      Int         @default(0)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, isActive])
}
